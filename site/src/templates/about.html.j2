{% extends "base.html.j2" %}
{% from "partials/macros.html.j2" import icon, media, contact_buttons, socials_row with context %}
{% block content %}
<section class="page-hero" aria-labelledby="page-title">
  <div class="container section-head">
    <p class="eyebrow">About Oks Cars</p>
    <h1 id="page-title"><span class="gold-text">Where approval stories</span> are made</h1>
    <p class="lead">{{ c.about.lead }}</p>
  </div>
</section>
<section class="section section--tight" aria-labelledby="story-title">
  <div class="container split">
    <div class="reveal reveal-l">
      <h2 id="story-title">Sulit cars, checked first</h2>
      <p>{{ c.about.p1 }}</p><p>{{ c.about.p2 }}</p>
      <ul class="stats stats--inline">
        <li><span class="stats__num" data-count="1000" data-suffix="+">1000+</span><span class="stats__lbl">happy clients</span></li>
        <li><span class="stats__num">{{ b.facebook_followers }}</span><span class="stats__lbl">followers on Facebook</span></li>
      </ul>
    </div>
    <div class="reveal reveal-r"><div class="photo-frame">{{ media(c.images.handover, "(min-width: 900px) 520px, 92vw", "media--wide") }}</div></div>
  </div>
</section>
<section class="section section--panel" id="reviews" aria-labelledby="rev-title">
  <div class="container">
    <p class="eyebrow reveal">Reviews</p>
    <h2 id="rev-title" class="reveal">1000+ happy clients, and counting!</h2>
    <div class="review-ph reveal" data-tilt>
      <p class="review-ph__q">“…”</p>
      <p>{{ c.reviews_ph | ph }}</p>
      <p class="note">Real client reviews will go here once Oks Cars shares them. We don't make up reviews.</p>
    </div>
    <p style="margin-top:1.25rem"><a class="text-link" href="{{ b.facebook_url }}" target="_blank" rel="noopener"><span>See client releases on Facebook</span>{{ icon("arrow") }}<span class="visually-hidden"> (opens in a new tab)</span></a></p>
  </div>
</section>
<section class="section cta-band" aria-labelledby="ab-cta"><div class="container reveal"><h2 id="ab-cta">Be our next approval story</h2>{{ contact_buttons("center") }}</div></section>
{% endblock %}
