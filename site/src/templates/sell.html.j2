{% extends "base.html.j2" %}
{% from "partials/macros.html.j2" import icon, steps_list, disabled_note, contact_buttons with context %}
{% block content %}
<section class="page-hero" aria-labelledby="page-title">
  <div class="container section-head">
    <p class="eyebrow">Sell your car · Antipolo, Rizal</p>
    <h1 id="page-title">Sell your car to Oks Cars</h1>
    <p class="lead">Walang hassle: send us your car's details and a few photos, and we'll take it from there.</p>
  </div>
</section>
<section class="section section--tight" aria-labelledby="sell-steps"><div class="container"><h2 id="sell-steps" class="reveal">How it works</h2>{{ steps_list(c.sell_steps) }}</div></section>
<section class="section section--panel" id="sell-form" aria-labelledby="sell-title">
  <div class="container quote-grid">
    <div class="reveal reveal-l">
      <p class="eyebrow">Your car</p><h2 id="sell-title">Tell us about your car</h2>
      {{ disabled_note("sell-note") }}
      {{ contact_buttons() }}
    </div>
    <form class="demo-form reveal reveal-r" aria-labelledby="sell-title" aria-describedby="sell-note" onsubmit="return false">
      <fieldset disabled>
        <legend class="visually-hidden">Sell your car (disabled in this demo)</legend>
        <div class="f-row">
          <div><label for="s-make">Make</label><input id="s-make" type="text" placeholder="e.g. Toyota"></div>
          <div><label for="s-model">Model</label><input id="s-model" type="text" placeholder="e.g. Vios 1.3 XLE"></div>
        </div>
        <div class="f-row">
          <div><label for="s-year">Year</label><input id="s-year" type="number" inputmode="numeric" min="1990" max="2027"></div>
          <div><label for="s-km">Mileage (km)</label><input id="s-km" type="number" inputmode="numeric" min="0" step="100"></div>
        </div>
        <label for="s-photos">Photos <span class="opt">(you can choose several)</span></label><input id="s-photos" type="file" accept="image/*" multiple>
        <div class="f-row">
          <div><label for="s-name">Name</label><input id="s-name" type="text" autocomplete="name"></div>
          <div><label for="s-mobile">Mobile number</label><input id="s-mobile" type="tel" autocomplete="tel"></div>
        </div>
        <button class="btn btn--primary" type="submit">{{ icon("car") }}Send car details</button>
      </fieldset>
      <p class="form-note">Disabled in this demo: nothing is sent.</p>
    </form>
  </div>
</section>
{% endblock %}
