{% extends "base.html.j2" %}
{% from "partials/macros.html.j2" import icon, media, contact_buttons, listing_card, steps_list, road_divider, package_panel with context %}
{% block content %}
{%- set parts = [
  {"id": "wheel-f", "file": "part-wheel", "w": 360, "h": 360, "x": 39.8, "y": 64.1, "size": 14, "from": "-130vw,4vh", "start": 0.14, "end": 0.30, "spin": 1, "alt": "gold alloy wheel"},
  {"id": "wheel-r", "file": "part-wheel", "w": 360, "h": 360, "x": 82.2, "y": 60.5, "size": 12, "from": "-150vw,4vh", "start": 0.18, "end": 0.34, "spin": 1, "desk": 1},
  {"id": "spoiler", "file": "part-spoiler", "w": 560, "h": 356, "x": 83, "y": 30, "size": 15, "from": "30vw,-90vh", "start": 0.40, "end": 0.54},
  {"id": "skirt", "file": "part-side-skirt", "w": 900, "h": 276, "x": 61, "y": 71.5, "size": 31, "from": "130vw,0vh", "start": 0.46, "end": 0.60, "desk": 1},
  {"id": "exhaust", "file": "part-exhaust", "w": 240, "h": 258, "x": 90.5, "y": 65.5, "size": 4.5, "from": "90vw,40vh", "start": 0.52, "end": 0.64, "desk": 1}
] %}
<section class="uphero" aria-labelledby="hero-title" data-uphero>
  <div class="uphero__sticky">
    <ol class="uphero__steps" aria-label="Car upgrade stages">
      <li data-step="0" aria-current="step"><span>Stock</span></li><li aria-hidden="true" class="uphero__arrow">→</li>
      <li data-step="1"><span>Upgraded</span></li><li aria-hidden="true" class="uphero__arrow">→</li>
      <li data-step="2"><span>Supercar</span></li>
    </ol>
    <div class="uphero__stage" role="img" aria-label="Illustration: a plain silver sedan upgraded step by step into a red, black and gold sports sedan with gold wheels and a rear wing">
      <img class="uphero__car uphero__car--1" src="img/hero/stage-1-1600.webp" srcset="img/hero/stage-1-900.webp 900w, img/hero/stage-1-1600.webp 1600w" sizes="(min-width: 900px) 78vw, 100vw" width="1600" height="905" alt="" fetchpriority="high" decoding="async">
      <img class="uphero__car uphero__car--2" data-srcset="img/hero/stage-2-900.webp 900w, img/hero/stage-2-1600.webp 1600w" sizes="(min-width: 900px) 78vw, 100vw" width="1600" height="905" alt="" decoding="async">
      <img class="uphero__car uphero__car--3" data-srcset="img/hero/stage-3-900.webp 900w, img/hero/stage-3-1600.webp 1600w" sizes="(min-width: 900px) 78vw, 100vw" width="1600" height="905" alt="" decoding="async">
      {%- for p in parts %}
      <div class="uphero__part{% if p.desk %} uphero__part--desk{% endif %}" data-part data-from="{{ p.from }}" data-start="{{ p.start }}" data-end="{{ p.end }}"{% if p.spin %} data-spin{% endif %} style="left: {{ p.x }}%; top: {{ p.y }}%; width: {{ p.size }}%" aria-hidden="true">
        <img class="uphero__ghost" data-src="img/hero/{{ p.file }}.webp" width="{{ p.w }}" height="{{ p.h }}" alt="" decoding="async">
        <img class="uphero__ghost" data-src="img/hero/{{ p.file }}.webp" width="{{ p.w }}" height="{{ p.h }}" alt="" decoding="async">
        <img class="uphero__sprite" data-src="img/hero/{{ p.file }}.webp" width="{{ p.w }}" height="{{ p.h }}" alt="" decoding="async">
        <span class="uphero__flash"></span>
      </div>
      {%- endfor %}
    </div>
    <span class="ph-badge image-badge uphero__badge">{{ c.meta.image_badge }}</span>
    <div class="uphero__copy">
      <p class="eyebrow">Antipolo, Rizal · Car dealership & auto financing</p>
      <h1 id="hero-title"><span class="gold-text">Where approval stories</span> are made</h1>
      <p class="lead">Quality brand-new and second-hand cars, checked by our mechanic, with fast financing approval through 10+ bank partners. Sulit na, walang hassle pa.</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href="tel:{{ b.phone_e164 }}">{{ icon("phone") }}Call {{ b.phone_display }}</a>
        <a class="btn btn--gold btn--lg" href="{{ b.facebook_url }}" target="_blank" rel="noopener">{{ icon("messenger") }}Message us on Facebook<span class="visually-hidden"> (opens in a new tab)</span></a>
        <a class="btn btn--ghost btn--lg" href="{{ page_href.financing }}">{{ icon("bolt") }}Tara, apply na!</a>
      </div>
    </div>
    <p class="uphero__hint" aria-hidden="true">Scroll to upgrade ↓</p>
  </div>
</section>

<section class="statbar" aria-label="Oks Cars in numbers">
  <div class="container">
    <ul class="stats">
      <li><span class="stats__num" data-count="1000" data-suffix="+">1000+</span><span class="stats__lbl">happy clients</span></li>
      <li><span class="stats__num" data-count="10" data-suffix="+">10+</span><span class="stats__lbl">bank partners</span></li>
      <li><span class="stats__num">{{ b.facebook_followers }}</span><span class="stats__lbl">followers on Facebook</span></li>
    </ul>
  </div>
</section>

<section class="promo" aria-label="Down payment promo">
  <div class="container promo__inner">
    <p><strong>{{ c.promo.text }}</strong> <span class="promo__note">{{ c.promo.note }}</span> {{ c.promo.ph | ph }}</p>
    <a class="btn btn--dark btn--sm" href="{{ page_href.financing }}#calc">{{ icon("calc") }}Estimate your monthly</a>
  </div>
</section>

<section class="section" aria-labelledby="why-title">
  <div class="container">
    <div class="section-head reveal"><p class="eyebrow">Why Oks Cars</p><h2 id="why-title">Sulit cars, fast approval</h2></div>
    <ul class="pillars">
      {%- for p in c.pillars %}
      <li class="pillar reveal" data-tilt style="--d: {{ loop.index0 * 0.08 }}s"><span class="pillar__icon">{{ icon(p.icon) }}</span><h3>{{ p.title }}</h3><p>{{ p.text }}</p></li>
      {%- endfor %}
    </ul>
  </div>
</section>
{{ road_divider() }}

<section class="section" aria-labelledby="cars-title">
  <div class="container">
    <div class="section-head section-head--row reveal">
      <div><p class="eyebrow">Cars for sale</p><h2 id="cars-title">A few sample units</h2></div>
      <a class="text-link" href="{{ page_href.cars }}"><span>See all sample listings</span>{{ icon("arrow") }}</a>
    </div>
    <div class="listings">{% for l in c.listings[:3] %}{{ listing_card(l, loop.index0) }}{% endfor %}</div>
    <p class="note">{{ c.listing_note }}</p>
  </div>
</section>

<section class="section section--panel" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head reveal"><p class="eyebrow">Financing</p><h2 id="how-title">From inquiry to release</h2></div>
    {{ steps_list(c.fin_steps) }}
    <div class="btn-row center"><a class="btn btn--gold" href="{{ page_href.financing }}#calc">{{ icon("calc") }}Try the monthly calculator</a></div>
  </div>
</section>

<section class="section" aria-labelledby="clients-title">
  <div class="container split">
    <div class="reveal reveal-l"><div class="photo-frame">{{ media(c.images.handover, "(min-width: 900px) 520px, 92vw", "media--wide") }}</div></div>
    <div class="reveal reveal-r">
      <p class="eyebrow">Client stories</p>
      <h2 id="clients-title"><span class="big-count" data-count="1000" data-suffix="+">1000+</span> happy clients, and counting!</h2>
      <p>{{ c.about.p2 }}</p>
      <p class="note">{{ c.reviews_ph | ph }}</p>
      <a class="text-link" href="{{ page_href.about }}"><span>About us and client stories</span>{{ icon("arrow") }}</a>
    </div>
  </div>
</section>

<section class="section section--panel" aria-labelledby="repair-title">
  <div class="container split">
    <div class="reveal reveal-l">
      <p class="eyebrow">Repair shop</p>
      <h2 id="repair-title">We fix cars too</h2>
      <p>Check-ups and repairs at our own shop, by the same mechanic who checks every unit we sell.</p>
      <a class="btn btn--ghost" href="{{ page_href.repair }}">{{ icon("wrench") }}Repair shop</a>
    </div>
    <div class="reveal reveal-r repair-art" aria-hidden="true">
      <span class="repair-art__wrench">{{ icon("wrench") }}</span>
      <span class="repair-art__gauge">{{ icon("gauge") }}</span>
    </div>
  </div>
</section>

<section class="section cta-band" aria-labelledby="cta-title">
  <div class="container reveal">
    <h2 id="cta-title">Tara, apply na!</h2>
    <p>Call or message us and we'll help you find the right unit and bank partner.</p>
    {{ contact_buttons("center") }}
  </div>
</section>

{{ package_panel() }}
{% endblock %}
